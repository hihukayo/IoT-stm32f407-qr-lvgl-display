# ======================================================================
# Doxygen 配置：只覆盖固件源码（STM32F407 QR + LVGL）
#
# 用法（在仓库根目录执行，相对路径按当前目录解析）：
#     doxygen docs/Doxyfile
# 输出在 docs/doxygen/html/index.html（已 gitignore，不入库）。
#
# Windows 上没有安装包时，可下载官方二进制包解压后直接运行 doxygen.exe。
# ======================================================================

PROJECT_NAME           = "STM32F407 QR + LVGL"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "上位机串口发送文本 -> STM32F407 本地生成二维码 -> ST7789 显示"
OUTPUT_DIRECTORY       = docs/doxygen

# ---- 输入 ----
INPUT                  = firmware/Core/Inc \
                         firmware/Core/Src
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8
OUTPUT_LANGUAGE        = Chinese

# ---- 提取 ----
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ---- 警告策略 ----
# 函数/宏有没有注释由 tools/check_doxygen.py 负责卡；这里只保留
# Doxygen 自身的一致性检查（@param 名字是否对得上、@ref 能否解析）。
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# ---- 输出 ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
GENERATE_MAN           = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---- 图形：不依赖 Graphviz（未安装时也能生成） ----
HAVE_DOT               = NO
