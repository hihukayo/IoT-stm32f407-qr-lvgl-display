# ======================================================================
# Doxyfile —— Doxygen 的配置文件（纯文本，一行一个"键 = 值"）
#
# 它不是代码、不参与编译，相当于给"文档生成器"的一份说明书：
#   - 扫哪些目录 ............ INPUT
#   - 认哪些文件 ............ FILE_PATTERNS
#   - 生成什么格式 .......... GENERATE_HTML / GENERATE_LATEX
#   - 输出到哪里 ............ OUTPUT_DIRECTORY
#   - 检查多严格 ............ WARN_*（缺注释、@param 名字对不上要不要报）
# 想调整文档内容/样式只改这个文件，重新跑一次 doxygen 即可，源码不用动。
#
# 用法（在仓库根目录执行；相对路径按"当前工作目录"解析）：
#     D:\Doxygen\doxygen.exe docs\Doxyfile     :: 本机安装位置（doxygen 1.12.0）
#     doxygen docs\Doxyfile                    :: 已把 D:\Doxygen 加进 PATH 时
# 产物在 docs/doxygen/html/index.html，已 gitignore，不入库。
#
# 没有安装 doxygen 也能读本文件：它把"这个工程对外暴露了什么接口"写在明处。
# ======================================================================

PROJECT_NAME           = "STM32F407 QR + LVGL"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "上位机串口发送文本 -> STM32F407 本地生成二维码 -> ST7789 显示"
OUTPUT_DIRECTORY       = docs/doxygen

# ---- 输入 ----
INPUT                  = firmware/Core/Inc \
                         firmware/Core/Src
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8
OUTPUT_LANGUAGE        = Chinese

# ---- 提取 ----
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ---- 警告策略 ----
# 函数/宏有没有注释由 tools/check_doxygen.py 负责卡；这里只保留
# Doxygen 自身的一致性检查（@param 名字是否对得上、@ref 能否解析）。
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# ---- 输出 ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
GENERATE_MAN           = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---- 图形：不依赖 Graphviz（未安装时也能生成） ----
HAVE_DOT               = NO
